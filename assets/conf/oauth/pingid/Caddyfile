# caddy-security v1.3.0 / go-authcrunch v1.3.8. Replace auth.example.com.
{
	admin off
	persist_config off
	security {
		oauth identity provider pingid {
			realm pingid
			driver generic
			client_id {env.PINGONE_CLIENT_ID}
			client_secret {env.PINGONE_CLIENT_SECRET}
			scopes openid profile email
			response_type code
			issuer {$PINGONE_ISSUER}
			metadata_url {$PINGONE_DISCOVERY_URL}
			login icon text "PingOne"
		}

		authentication portal myportal {
			enable identity provider pingid
			crypto default token lifetime 900
			crypto key sign-verify {env.AUTHCRUNCH_SIGNING_KEY}
			ui {
				links {
					"Example app" /app
					"My identity" /auth/whoami
				}
			}
			transform user {
				match realm pingid
				action overwrite role authp/user
			}
			transform user {
				match realm pingid
				match sub {$PINGONE_ALLOWED_SUB}
				action add role app/member
			}
		}
		authorization policy apppolicy {
			set auth url https://auth.example.com/auth/
			crypto key verify {env.AUTHCRUNCH_SIGNING_KEY}
			validate bearer header
			allow roles app/member
		}
	}
}

auth.example.com {
	route {
		redir /auth /auth/ 308
		authenticate /auth/* with myportal
		@app path /app /app/*
		route @app {
			authorize with apppolicy
			respond "You reached the protected example app." 200
		}
		respond "Open /app to begin." 200
	}
}
