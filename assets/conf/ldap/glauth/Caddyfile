# GLAuth configured with an LDAPS listener and the matching certificate.
# caddy-security v1.3.0; copy attribute names/DNs from your actual GLAuth schema.
{
	security {
		ldap identity store directory {
			realm directory
			servers {
				ldaps://directory.example.com:3894
			}
			trusted_authority /etc/authcrunch/directory-ca.pem
			username "cn=serviceuser,ou=svcaccts,dc=glauth,dc=com"
			password file:/etc/authcrunch/ldap-bind.secret
			search_base_dn "dc=glauth,dc=com"
			search_user_filter "(&(|(uid=%s)(mail=%s))(objectClass=posixAccount))"
			attributes {
				name givenname
				surname sn
				username uid
				member_of memberOf
				email mail
			}
			groups {
				"ou=superheros,ou=groups,dc=glauth,dc=com" app/member
				"ou=vpn,ou=groups,dc=glauth,dc=com" vpn/member
			}
		}

		authentication portal myportal {
			enable identity store directory
			crypto key sign-verify {env.AUTHCRUNCH_SIGNING_KEY}
			ui {
				links {
					"Example app" /app
					"My identity" /auth/whoami
				}
			}
			transform user {
				match realm directory
				action add role authp/user
			}
		}

		authorization policy apppolicy {
			set auth url https://auth.example.com/auth/
			crypto key verify {env.AUTHCRUNCH_SIGNING_KEY}
			validate bearer header
			allow roles app/member
		}
	}
}

auth.example.com {
	route {
		redir /auth /auth/ 308
		authenticate /auth/* with myportal
		@app path /app /app/*
		route @app {
			authorize with apppolicy
			reverse_proxy 127.0.0.1:8080
		}
	}
}
