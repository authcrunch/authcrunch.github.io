# Secondary DN-based group lookup over verified LDAPS; caddy-security v1.3.0.
{
	security {
		ldap identity store directory {
			realm directory
			servers {
				ldaps://directory.example.com:636 posix_groups
			}
			trusted_authority /etc/authcrunch/directory-ca.pem
			username "cn=authcrunch,ou=services,dc=example,dc=com"
			password file:/etc/authcrunch/ldap-bind.secret
			search_base_dn "dc=example,dc=com"
			search_user_filter "(&(|(uid=%s)(mail=%s))(objectClass=inetOrgPerson))"
			search_group_filter "(&(uniqueMember=%s)(objectClass=groupOfUniqueNames))"
			attributes {
				name givenName
				surname sn
				username uid
				member_of memberOf
				email mail
			}
			groups {
				"cn=app-members,ou=groups,dc=example,dc=com" app/member
				"cn=app-editors,ou=groups,dc=example,dc=com" app/member app/editor
			}
		}

		authentication portal myportal {
			enable identity store directory
			crypto key sign-verify {env.AUTHCRUNCH_SIGNING_KEY}
			ui {
				links {
					"Example app" /app
					"My identity" /auth/whoami
				}
			}
			transform user {
				match realm directory
				action add role authp/user
			}
		}

		authorization policy apppolicy {
			set auth url https://auth.example.com/auth/
			crypto key verify {env.AUTHCRUNCH_SIGNING_KEY}
			validate bearer header
			allow roles app/member
		}
	}
}

auth.example.com {
	route {
		redir /auth /auth/ 308
		authenticate /auth/* with myportal
		@app path /app /app/*
		route @app {
			authorize with apppolicy
			reverse_proxy 127.0.0.1:8080
		}
	}
}
