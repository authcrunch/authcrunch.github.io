# Adapted from authcrunch/authcrunch/assets/e2e-login/Caddyfile.
# Local learning only: public demo credentials and signing key; no environment variables.
{
	admin off
	persist_config off
	auto_https disable_redirects
	skip_install_trust
	on_demand_tls {
		ask http://localhost:5555/
	}
	storage file_system ./data/caddy

	security {
		local identity store localdb {
			realm local
			path :memory:
			user alice {
				name Alice Example
				email alice@example.test
				password "LocalDemoPassword123!"
				roles authp/user app/member
			}
			user bob {
				name Bob Example
				email bob@example.test
				password "LocalDemoPassword123!"
				roles authp/user
			}
		}

		authentication portal myportal {
			enable identity store localdb
			crypto default token lifetime 300
			crypto key sign-verify "LocalDemoSigningKey-ChangeBeforeDeployment-0123456789"
			cookie guess domain enabled
			cookie prefix AUTHTEST
			trust login redirect uri domain exact localhost:8443 path prefix /
			ui {
				links {
					"Example app" / icon "las la-external-link-alt"
				}
			}
		}

		authorization policy apppolicy {
			set auth url https://localhost:8443/auth/login
			crypto key verify "LocalDemoSigningKey-ChangeBeforeDeployment-0123456789"
			allow roles authp/admin authp/user
			set session_id cookie name AUTHTEST_SESSION_ID
			set access_token cookie name AUTHTEST_ACCESS_TOKEN
		}
	}
}

http://localhost:5555 {
	bind 127.0.0.1
	@allowed_localhost query domain=localhost
	respond @allowed_localhost 200
	respond 400
}

https://localhost:8443 {
	bind 127.0.0.1
	tls internal {
		on_demand
	}

	route /healthz {
		respond "AuthCrunch demo is running." 200
	}

	route /auth* {
		redir /auth /auth/ 308
		authenticate with myportal
	}

	route /* {
		authorize with apppolicy
		respond "You reached the protected app." 200
	}
}
