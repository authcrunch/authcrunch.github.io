# Local registration collection: caddy-security v1.3.0 / go-authcrunch v1.3.8.
# SMTP is a loopback-only disposable mail sink, not a production mail service.
{
	security {
		local identity store localdb {
			realm local
			path /var/lib/authcrunch/users.json
		}

		messaging email provider localmail {
			address 127.0.0.1:1025
			protocol smtp
			passwordless
			sender no-reply@example.com "Example registration"
		}

		user registration localregistry {
			dropbox /var/lib/authcrunch/registrations.json
			title "Request an account"
			code {env.AUTHCRUNCH_REGISTRATION_CODE}
			require accept terms
			link terms https://auth.example.com/terms
			link privacy https://auth.example.com/privacy
			allow exact domain example.com
			email provider localmail
			admin email admin@example.com
			identity store localdb local
		}

		authentication portal myportal {
			enable identity store localdb
			crypto key sign-verify {env.AUTHCRUNCH_SIGNING_KEY}
		}
	}
}

auth.example.com {
	route {
		redir /auth /auth/ 308
		authenticate /auth/* with myportal
	}
}
