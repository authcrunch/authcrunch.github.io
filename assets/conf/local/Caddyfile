# Local learning example: run from a new directory, never on a public host.
{
	admin off
	persist_config off
	storage file_system ./data/caddy

	security {
		local identity store localdb {
			realm local
			path ./data/users.json
			user alice {
				name Alice Example
				email alice@example.test
				password "LocalDemoPassword123!"
				roles authp/user app/guest app/member
			}
			user bob {
				name Bob Example
				email bob@example.test
				password "LocalDemoPassword123!"
				roles authp/user app/guest
			}
			user carol {
				name Carol Example
				email carol@example.test
				password "LocalDemoPassword123!"
				roles authp/user app/guest app/member app/admin
			}
		}

		authentication portal myportal {
			enable identity store localdb
			crypto key sign-verify {env.AUTHCRUNCH_DEMO_SECRET}
			cookie insecure enabled
			ui {
				links {
					"Guest content" /guests
					"Member content" /users
					"Administrator content" /admins
					"My identity" /auth/whoami
				}
			}
		}

		authorization policy guestpolicy {
			set auth url http://localhost:9080/auth/
			crypto key verify {env.AUTHCRUNCH_DEMO_SECRET}
			allow roles app/guest
		}

		authorization policy memberpolicy {
			set auth url http://localhost:9080/auth/
			crypto key verify {env.AUTHCRUNCH_DEMO_SECRET}
			allow roles app/member
		}

		authorization policy adminpolicy {
			set auth url http://localhost:9080/auth/
			crypto key verify {env.AUTHCRUNCH_DEMO_SECRET}
			allow roles app/admin
		}
	}
}

http://localhost:9080 {
	bind 127.0.0.1

	route {
		redir /auth /auth/ 308

		authenticate /auth/* with myportal

		@guestpolicy path /guests /guests/*
		route @guestpolicy {
			authorize with guestpolicy
			respond "Guest application content." 200
		}

		@memberpolicy path /users /users/*
		route @memberpolicy {
			authorize with memberpolicy
			respond "Member application content." 200
		}

		@adminpolicy path /admins /admins/*
		route @adminpolicy {
			authorize with adminpolicy
			respond "Administrator application content." 200
		}

		respond "AuthCrunch local policy demo. Open /guests to begin." 200
	}
}
